#!/usr/bin/env bash
# =============================================================================
# install-packages - install system packages for the current OS.
#
#   macOS  -> brew bundle (Brewfile)
#   Ubuntu -> apt-get install (packages/apt.txt)
#
# Invoked by the `packages` mise task.
# =============================================================================
set -euo pipefail

DOTFILES_PATH="${DOTFILES_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

install_macos() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found; run install.sh / up first." >&2
    exit 1
  fi

  # Recent Homebrew refuses to load formulae from third-party taps until they
  # are explicitly trusted, which aborts `brew bundle`. Trust any taps declared
  # in the Brewfile up front. This is idempotent once trusted and a harmless
  # no-op on older Homebrew that lacks the `trust` subcommand.
  while IFS= read -r tap_name; do
    [ -n "$tap_name" ] && brew trust "$tap_name" 2>/dev/null || true
  done < <(
    sed -nE 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/p' \
      "$DOTFILES_PATH/Brewfile"
  )

  # The gcloud-cli cask runs `gcloud config virtualenv create`, which needs a
  # `virtualenv` executable on PATH and otherwise fails the whole bundle. When
  # the Brewfile installs that cask, provision virtualenv via pipx up front and
  # make sure pipx's bin dir is on PATH so the cask's postinstall can find it.
  if grep -qE '^[[:space:]]*cask[[:space:]]+"gcloud-cli"' "$DOTFILES_PATH/Brewfile"; then
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v virtualenv >/dev/null 2>&1; then
      command -v pipx >/dev/null 2>&1 || brew install pipx
      pipx install virtualenv >/dev/null 2>&1 || true
    fi
  fi

  brew bundle --no-upgrade --file "$DOTFILES_PATH/Brewfile"
}

install_ubuntu() {
  local list="$DOTFILES_PATH/packages/apt.txt"
  # Strip comments/blank lines into a package array.
  local pkgs=()
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [ -n "$line" ] && pkgs+=("$line")
  done < "$list"

  # Use sudo only when not already root (e.g. inside containers).
  local SUDO=""
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || { echo "need root or sudo to install apt packages" >&2; exit 1; }
    SUDO="sudo"
  fi
  $SUDO apt-get update
  DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y "${pkgs[@]}"
}

case "$(uname -s)" in
  Darwin) install_macos ;;
  Linux)
    if [ -e /etc/lsb-release ] || command -v apt-get >/dev/null 2>&1; then
      install_ubuntu
    else
      echo "Unsupported Linux distro (expected Ubuntu/apt)." >&2
      exit 1
    fi
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac
